# Copy this file to .env.local and fill in your Supabase project credentials.
# Found in Supabase dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS, server-only, used exclusively by the
# parent-facing API routes (src/app/api/parent/**). Get it from Supabase
# dashboard -> Project Settings -> API -> service_role (click "reveal").
# NEVER prefix this with NEXT_PUBLIC_ — it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the parent session cookie. Not a Supabase credential — generate
# your own random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PARENT_SESSION_SECRET=

# Signs the classroom-contact session cookie (/classroom) — a completely
# separate trust boundary from parent access, so this must be a DIFFERENT
# random value than PARENT_SESSION_SECRET above, generated the same way.
CLASSROOM_CONTACT_SESSION_SECRET=
